{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": ".tsbuild/execution-runtime",
    "tsBuildInfoFile": ".tsbuild/execution-runtime.tsbuildinfo",
    "rootDir": "server",
    "types": ["node"]
  },
  "references": [{ "path": "./tsconfig.domain.json" }],
  "include": ["server/execution-runtime/**/*.ts"]
}
