{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhiza.dev/architecture-gates/milestone-evidence/1.0.0",
  "title": "Rhiza V4 milestone gate evidence",
  "type": "object",
  "required": ["$schema", "schema_version", "milestone", "architecture_version", "commit", "fixtures", "commands", "checksums", "failure_classification", "known_exceptions", "environment", "started_at", "completed_at", "result"],
  "allOf": [{
    "if": { "properties": { "milestone": { "enum": ["M03", "M04", "M05", "M06", "M07"] } }, "required": ["milestone"] },
    "then": {
      "properties": { "severity": {}, "thresholds": {}, "observed_metrics": {}, "failure_injection_checkpoint": {}, "recovery_command": {} },
      "required": ["severity", "thresholds", "observed_metrics", "failure_injection_checkpoint", "recovery_command"]
    }
  }],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://rhiza.dev/architecture-gates/milestone-evidence/1.0.0" },
    "schema_version": { "const": "1.0.0" },
    "milestone": { "type": "string", "pattern": "^M[0-9]{2}$" },
    "architecture_version": { "enum": ["V4.0", "V4.1", "V4.2"] },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "fixtures": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["id", "path", "role"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^[^/].*" },
          "role": { "enum": ["fixture_registry", "characterization_map", "acceptance_fixture"] }
        }
      }
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["command", "result"], "additionalProperties": false,
        "properties": { "command": { "type": "string", "minLength": 1 }, "result": { "enum": ["pass", "fail", "skipped"] } }
      }
    },
    "checksums": {
      "type": "object", "minProperties": 2,
      "additionalProperties": {
        "type": "object", "required": ["algorithm", "current", "recorded_commit"], "additionalProperties": false,
        "properties": {
          "algorithm": { "const": "sha256" },
          "current": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "recorded_commit": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "failure_classification": {
      "type": "object", "required": ["classification", "rationale"], "additionalProperties": false,
      "properties": { "classification": { "enum": ["none", "product_defect", "test_defect", "environment", "known_exception"] }, "rationale": { "type": "string", "minLength": 1 } }
    },
    "severity": { "enum": ["blocking", "observational"] },
    "thresholds": { "type": "object", "minProperties": 1 },
    "observed_metrics": { "type": "object", "minProperties": 1 },
    "failure_injection_checkpoint": {
      "type": "object", "required": ["checkpoint", "injection_command", "expected"], "additionalProperties": false,
      "properties": { "checkpoint": { "type": "string", "minLength": 1 }, "injection_command": { "type": "string", "minLength": 1 }, "expected": { "type": "string", "minLength": 1 } }
    },
    "recovery_command": { "type": "string", "minLength": 1 },
    "known_exceptions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["owner", "expiry", "adr_or_issue", "severity"], "additionalProperties": false,
        "properties": {
          "owner": { "type": "string", "minLength": 1 }, "expiry": { "type": "string", "format": "date" },
          "adr_or_issue": { "type": "string", "minLength": 1 }, "severity": { "enum": ["blocking", "observational"] }
        }
      }
    },
    "environment": {
      "type": "object", "required": ["node", "os", "cpu", "memory_bytes"], "additionalProperties": false,
      "properties": { "node": { "type": "string" }, "os": { "type": "string" }, "cpu": { "type": "string" }, "memory_bytes": { "type": "integer", "minimum": 1 } }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "result": { "enum": ["pass", "fail"] }
  }
}
