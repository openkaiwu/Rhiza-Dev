{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhiza.dev/architecture-gates/evidence-manifest/1.0.0",
  "title": "Rhiza architecture gate evidence",
  "type": "object",
  "required": [
    "$schema", "schema_version", "gate_id", "severity", "architecture_version", "commit", "baseline",
    "fixture_id", "fixture_digest", "command", "environment_profile", "thresholds",
    "observed_metrics", "absolute_metrics", "regression_vs_g0", "checksums",
    "artifact_descriptors", "failure_classification", "failure_injection_checkpoint",
    "recovery_command", "manual_evidence_links", "known_exceptions", "started_at",
    "completed_at", "result"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://rhiza.dev/architecture-gates/evidence-manifest/1.0.0" },
    "schema_version": { "const": "1.0.0" },
    "gate_id": { "const": "G0" },
    "severity": { "const": "blocking" },
    "architecture_version": { "const": "0818-v3.0" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "baseline": {
      "type": "object",
      "required": ["commit", "tag", "tag_object_type", "signature_status", "signature_reason"],
      "additionalProperties": false,
      "properties": {
        "commit": { "const": "b29d94fb034678e0c9d5660848e92e995311d4da" },
        "tag": { "const": "pre-0815-engineering-baseline" },
        "tag_object_type": { "const": "annotated" },
        "signature_status": { "enum": ["signed", "unsigned"] },
        "signature_reason": { "type": "string", "minLength": 1 }
      }
    },
    "fixture_id": { "const": "g0-fixture-registry-v1" },
    "fixture_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "command": { "const": "pnpm g0:evidence" },
    "environment_profile": {
      "type": "object",
      "required": ["declared", "actual"],
      "additionalProperties": false,
      "properties": {
        "declared": { "type": "object" },
        "actual": {
          "type": "object",
          "required": ["node", "os", "cpu", "memory_bytes", "store_adapter"],
          "additionalProperties": false,
          "properties": {
            "node": { "type": "string" }, "os": { "type": "string" }, "cpu": { "type": "string" },
            "memory_bytes": { "type": "integer", "minimum": 1 }, "store_adapter": { "const": "json" }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["warmup_count", "sample_count", "external_network", "failures", "timeouts", "drops"],
      "additionalProperties": false,
      "properties": {
        "warmup_count": { "const": 20 }, "sample_count": { "const": 200 },
        "external_network": { "const": false }, "failures": { "const": 0 },
        "timeouts": { "const": 0 }, "drops": { "const": 0 }
      }
    },
    "observed_metrics": { "type": "object", "minProperties": 5, "additionalProperties": { "$ref": "#/$defs/metric" } },
    "absolute_metrics": { "type": "object", "minProperties": 5 },
    "regression_vs_g0": {
      "type": "object", "required": ["reason", "metrics"], "additionalProperties": false,
      "properties": { "reason": { "type": "string" }, "metrics": { "type": "object", "minProperties": 5 } }
    },
    "checksums": {
      "type": "object", "minProperties": 4,
      "additionalProperties": {
        "type": "object", "required": ["algorithm", "value"], "additionalProperties": false,
        "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    "artifact_descriptors": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "media_type", "canonicalization_version", "checksum_ref"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string" }, "path": { "type": "string" },
          "media_type": { "const": "application/json" }, "canonicalization_version": { "type": "string" },
          "checksum_ref": { "type": "string" }
        }
      }
    },
    "failure_classification": { "$ref": "#/$defs/exceptions" },
    "failure_injection_checkpoint": {
      "type": "object", "required": ["checkpoint", "injection_command", "expected"], "additionalProperties": false,
      "properties": { "checkpoint": { "type": "string" }, "injection_command": { "type": "string" }, "expected": { "type": "string" } }
    },
    "recovery_command": { "type": "string" },
    "manual_evidence_links": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["item", "status", "path", "target_work_package"], "additionalProperties": false,
        "properties": {
          "item": { "type": "string" }, "status": { "const": "pending" },
          "path": { "const": "docs/M6_ACCEPTANCE.md" }, "target_work_package": { "enum": ["WP-2.1", "WP-2.3"] }
        }
      }
    },
    "known_exceptions": { "$ref": "#/$defs/exceptions" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "result": { "const": "pass" }
  },
  "$defs": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["owner", "expiry", "adr_or_issue", "severity"], "additionalProperties": true,
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "expiry": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "adr_or_issue": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocking", "observational"] }
        }
      }
    },
    "metric": {
      "type": "object",
      "required": ["metric", "warmup_count", "sample_count", "concurrency", "external_network", "failures", "timeouts", "drops", "p50", "p95", "p99", "max"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" }, "warmup_count": { "const": 20 }, "sample_count": { "const": 200 },
        "concurrency": { "const": 1 }, "external_network": { "const": false }, "failures": { "const": 0 },
        "timeouts": { "const": 0 }, "drops": { "const": 0 }, "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 }, "p99": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 }
      }
    }
  }
}
