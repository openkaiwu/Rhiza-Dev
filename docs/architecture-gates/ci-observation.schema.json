{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhiza.dev/architecture-gates/ci-observation/1.0.0",
  "title": "Rhiza G0 CI observation",
  "type": "object",
  "required": ["$schema", "schema_version", "gate_id", "severity", "commit", "provenance", "command", "environment_profile", "observed_metrics", "checksums", "started_at", "completed_at", "result"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://rhiza.dev/architecture-gates/ci-observation/1.0.0" },
    "schema_version": { "const": "1.0.0" },
    "gate_id": { "const": "G0" },
    "severity": { "const": "observational", "description": "Required for newly generated observations; omitted only by the immutable pre-severity G0 artifact." },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "provenance": {
      "type": "object",
      "required": ["ci", "repository", "workflow", "run_id", "run_attempt", "event_name", "ref", "sha"],
      "additionalProperties": false,
      "properties": {
        "ci": { "enum": ["github-actions", "local"] },
        "repository": { "type": ["string", "null"] },
        "workflow": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "run_attempt": { "type": ["string", "null"] },
        "event_name": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "command": { "const": "pnpm g0:observe" },
    "environment_profile": {
      "type": "object",
      "required": ["declared", "actual"],
      "additionalProperties": false,
      "properties": {
        "declared": { "$ref": "https://rhiza.dev/architecture-gates/environment-profile/1.0.0" },
        "actual": {
          "type": "object",
          "required": ["node", "os", "cpu", "memory_bytes", "store_adapter"],
          "additionalProperties": false,
          "properties": {
            "node": { "type": "string" }, "os": { "type": "string" }, "cpu": { "type": "string" },
            "memory_bytes": { "type": "integer", "minimum": 1 }, "store_adapter": { "const": "json" }
          }
        }
      }
    },
    "observed_metrics": {
      "type": "object", "minProperties": 5,
      "additionalProperties": {
        "type": "object",
        "required": ["metric", "warmup_count", "sample_count", "concurrency", "external_network", "failures", "timeouts", "drops", "p50", "p95", "p99", "max"],
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string" }, "warmup_count": { "const": 20 }, "sample_count": { "const": 200 },
          "concurrency": { "const": 1 }, "external_network": { "const": false },
          "failures": { "type": "integer", "minimum": 0 }, "timeouts": { "type": "integer", "minimum": 0 }, "drops": { "type": "integer", "minimum": 0 },
          "p50": { "type": "number", "minimum": 0 }, "p95": { "type": "number", "minimum": 0 }, "p99": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 }
        }
      }
    },
    "checksums": {
      "type": "object", "minProperties": 5,
      "additionalProperties": {
        "type": "object", "required": ["algorithm", "value"], "additionalProperties": false,
        "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "result": { "const": "pass" }
  }
}
