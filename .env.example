# OpenAI-compatible provider. The key is read only by the Rhiza backend.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Set true only for trusted local endpoints such as Ollama that do not require authentication.
AI_ALLOW_NO_KEY=false

# Optional provider tuning.
AI_PROVIDER_NAME=OpenAI-compatible
AI_CHAT_PATH=/chat/completions
AI_TIMEOUT_MS=90000
AI_TEMPERATURE=0.4
# JSON object for providers that require extra headers, e.g. {"HTTP-Referer":"https://example.com"}
AI_EXTRA_HEADERS={}

API_PORT=8787
# Used by `npm start`; the production server serves both the API and dist/ frontend.
SERVE_FRONTEND=true

# Comma-separated, explicit opt-ins. Unknown flags fail fast at startup.
# RHIZA_FEATURE_FLAGS=postgresPersistence=true,libreChatRuntime=false,fileContext=false
RHIZA_FEATURE_FLAGS=
# Optional external PostgreSQL. Leave unset to use the embedded PGlite database.
# DATABASE_URL=postgresql://rhiza:rhiza@127.0.0.1:5432/rhiza
# Optional default Workspace UUID. Leave unset to use Rhiza's deterministic local default.
# RHIZA_PROJECT_ID=00000000-0000-4000-8000-000000000001
